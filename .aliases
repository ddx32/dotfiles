# Aliases — sourced by .shellrc (bash and zsh). Keep POSIX-compatible.

# Bash aliases
serverhere() { ~/bin/server-here.sh "$@"; }
alias mount-efi="~/bin/mount-efi.sh"

if command -v eza >/dev/null 2>&1; then
	alias ls="eza"
fi

# Zed editor CLI (Arch package names it zeditor)
if command -v zeditor >/dev/null 2>&1; then
	alias zed="zeditor"
fi
