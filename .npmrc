# GitLab registry auth. NPM_TOKEN comes from each project's .env via direnv;
# pnpm only expands env vars in user-level config, never in a committed .npmrc.
//gitlab.com/api/v4/:_authToken=${NPM_TOKEN}
//gitlab.com/api/v4/packages/npm/:_authToken=${NPM_TOKEN}
//gitlab.com/api/v4/projects/:_authToken=${NPM_TOKEN}
